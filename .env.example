# Server-side only. Never put these in a public frontend bundle.
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-1.5
IMAGE_QUALITY=high
AVATAR_SERVICE_TOKEN=replace-with-a-long-random-service-secret
AVATAR_DATA_DIR=/app/data
# Optional compatible provider; must support multi-image /images/edits and base64 output.
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional caption font; Docker includes Noto CJK. Set to your local CJK font on other hosts.
# AVATAR_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# Optional system FFmpeg override for platforms without a bundled binary.
# IMAGEIO_FFMPEG_EXE=/usr/bin/ffmpeg
